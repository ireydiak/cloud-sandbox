# The app runs without a .env file: set these as real environment variables.
APP_NAME=legacy
APP_ENV=production
APP_DEBUG=false
# Required. Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Logging: JSON lines on stdout (default). LOG_LEVEL=info logs requests.
LOG_CHANNEL=stdout
LOG_LEVEL=info

# Stateless: nothing below needs to be changed.
CACHE_STORE=array
